# WalletConnect Project ID (必填)
# 去 https://cloud.walletconnect.com 注册免费账号申请
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# 应用名字(会显示在钱包连接弹窗里)
NEXT_PUBLIC_APP_NAME=Web3 Dashboard Demo

# 是否启用测试网(Sepolia 等)
NEXT_PUBLIC_ENABLE_TESTNETS=true

# 可选: Alchemy API Key (不填会用公共 RPC,会被限流)
# https://dashboard.alchemy.com 免费申请
NEXT_PUBLIC_ALCHEMY_API_KEY=
